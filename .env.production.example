# Deployment mode. Use staging for the restricted tester deployment; production
# rejects all staging/debug session credentials.
APP_ENV=production

# Images. Choose an immutable application release tag; the remaining defaults are pinned.
APP_IMAGE_TAG=0.1.0
APP_IMAGE_REPOSITORY=agentic-backend
WORKER_IMAGE_REPOSITORY=agentic-capability-worker
VOICE_AGENT_IMAGE_REPOSITORY=agentic-voice-agent
DEBUG_CHAT_IMAGE_REPOSITORY=agentic-debug-chat
LIVEKIT_SERVER_IMAGE=livekit/livekit-server:v1.13.1
LIVEKIT_SIP_IMAGE=livekit/sip:v1.7.0
CADDY_IMAGE=caddy:2.11.4-alpine

# Public DNS and TLS: replace all example hostnames and set a real ACME email.
API_DOMAIN=api.example.com
DEBUG_CHAT_DOMAIN=debug.example.com
LIVEKIT_DOMAIN=livekit.example.com
CADDY_EMAIL=ops@example.com

# Debug Chat edge authentication. Choose a username. Generate the hash with
# `docker run --rm -it caddy:2.11.4-alpine caddy hash-password` and single-quote
# the result so Compose preserves its $ characters.
DEBUG_CHAT_BASIC_AUTH_USER=replace-with-tester-username
DEBUG_CHAT_BASIC_AUTH_HASH='generate-with-caddy-hash-password'

# PostgreSQL: generate POSTGRES_PASSWORD, for example with:
# openssl rand -hex 32
POSTGRES_USER=agentic
POSTGRES_DB=agentic
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-32

# Backend authentication: generate two different values with:
# openssl rand -hex 32
VOICE_SESSION_TOKEN_SECRET=generate-independent-voice-secret
LIVEKIT_SESSION_AUTH_SECRET=generate-independent-session-auth-secret
LIVEKIT_BACKEND_TOKEN_TTL_SECONDS=7200

# Restricted staging session access. Leave these values exactly as-is for production.
# For staging set APP_ENV=staging, enable the flag, generate an independent credential
# with `openssl rand -hex 32`, and list only explicitly authorized tenant IDs.
LIVEKIT_STAGING_AUTH_ENABLED=false
LIVEKIT_STAGING_AUTH_CREDENTIAL=
LIVEKIT_STAGING_ALLOWED_TENANTS=

# LiveKit: generate a project key/secret pair with:
# docker run --rm livekit/livekit-server:v1.13.1 generate-keys
# Replace the public URL and documentation IP. Keep LIVEKIT_INTERNAL_URL unchanged.
# LIVEKIT_INTERNAL_URL is private Docker DNS; LIVEKIT_PUBLIC_URL must match LIVEKIT_DOMAIN.
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=generate-with-livekit-server-generate-keys
LIVEKIT_INTERNAL_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=wss://livekit.example.com
LIVEKIT_NODE_IP=203.0.113.10
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT_START=50000
LIVEKIT_RTC_UDP_PORT_END=50100
LIVEKIT_TURN_ENABLED=true
LIVEKIT_TURN_UDP_PORT=3478
# Bridge address used by LiveKit Server and application containers.
LIVEKIT_REDIS_ADDRESS=redis:6379

# Inbound SIP is opt-in. When enabled, also activate the `sip` Compose profile;
# deploy/deploy.sh does that automatically. Keep disabled until the manual trunk,
# DID assignment, and dispatch rule exist.
INBOUND_SIP_ENABLED=false
LIVEKIT_SIP_DOMAIN=sip.example.com
LIVEKIT_SIP_EXTERNAL_IP=203.0.113.10
LIVEKIT_SIP_INTERNAL_URL=ws://127.0.0.1:7880
LIVEKIT_SIP_REDIS_ADDRESS=127.0.0.1:6379
LIVEKIT_SIP_HEALTH_PORT=8082
LIVEKIT_SIP_PORT=5060
LIVEKIT_SIP_RTP_PORT_START=10000
LIVEKIT_SIP_RTP_PORT_END=20000
LIVEKIT_SIP_EXPECTED_TRUNK_ID=
LIVEKIT_SIP_EXPECTED_RULE_ID=

# AI providers: use production-scoped credentials.
AZURE_OPENAI_ENDPOINT=https://replace-with-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-azure-openai-api-key
ELEVENLABS_API_KEY=replace-with-elevenlabs-api-key

# Google Sheets: store the real JSON outside Git and restrict its file permissions.
GOOGLE_SERVICE_ACCOUNT_FILE=./app/secrets/google-service-account.production.json

# Operations.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5
BACKUP_DIR=/var/backups/agentic-backend
