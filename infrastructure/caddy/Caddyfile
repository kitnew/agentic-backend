{
	email {$CADDY_EMAIL}
	admin off
}

(access_log) {
	log {
		output stdout
		format filter {
			request>headers delete
			request>uri delete
			wrap json
		}
	}
}

{$API_DOMAIN} {
	import access_log

	reverse_proxy backend:8000 {
		health_uri /health
		health_timeout 3s
	}
}

{$DEBUG_CHAT_DOMAIN} {
	import access_log

	@debug_chat_api path /api/*
	handle @debug_chat_api {
		reverse_proxy debug-chat:80
	}

	handle {
		basic_auth {
			{$DEBUG_CHAT_BASIC_AUTH_USER} {$DEBUG_CHAT_BASIC_AUTH_HASH}
		}

		reverse_proxy debug-chat:80
	}
}

{$ADMIN_WEB_DOMAIN} {
	import access_log

	basic_auth {
		{$ADMIN_WEB_BASIC_AUTH_USER} {$ADMIN_WEB_BASIC_AUTH_HASH}
	}

	@admin_api path /admin/*
	handle @admin_api {
		reverse_proxy backend:8000 {
			header_up Authorization "Bearer {$ADMIN_API_TOKEN}"
		}
	}

	handle {
		reverse_proxy admin-web:8080
	}
}

{$LIVEKIT_DOMAIN} {
	import access_log

	reverse_proxy livekit:7880 {
		stream_close_delay 5m
	}
}
