{
	email {$CADDY_EMAIL}
	admin off
}

(access_log) {
	log {
		output stdout
		format filter {
			request>headers delete
			request>uri delete
			wrap json
		}
	}
}

{$API_DOMAIN} {
	import access_log

	reverse_proxy backend:8000 {
		health_uri /health
		health_timeout 3s
	}
}

{$ADMIN_WEB_DOMAIN} {
	import access_log

	basic_auth {
		{$ADMIN_WEB_BASIC_AUTH_USER} {$ADMIN_WEB_BASIC_AUTH_HASH}
	}

	@admin_api path /admin/*
	handle @admin_api {
		reverse_proxy backend:8000 {
			header_up Authorization "Bearer {$ADMIN_API_TOKEN}"
		}
	}

	@control_plane_api path /control-plane/*
	handle @control_plane_api {
		uri strip_prefix /control-plane
		rewrite * /v1{uri}
		reverse_proxy control-plane-service:8000 {
			header_up Authorization "Bearer {$CONTROL_PLANE_MANAGEMENT_TOKEN}"
		}
	}

	handle {
		reverse_proxy admin-web:8080
	}
}

{$GRAFANA_DOMAIN} {
	import access_log

	reverse_proxy grafana:3000
}

{$LIVEKIT_DOMAIN} {
	import access_log

	reverse_proxy livekit:7880 {
		stream_close_delay 5m
	}
}
