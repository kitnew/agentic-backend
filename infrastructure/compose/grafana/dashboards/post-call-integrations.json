{
  "uid": "post-call-integrations",
  "title": "Post-call & Integrations",
  "tags": ["agentic-backend", "post-call", "integrations"],
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": [
    {"name": "environment", "label": "Environment", "type": "query", "datasource": {"uid": "prometheus", "type": "prometheus"}, "query": "label_values(post_call_executions_total, deployment_environment_name)", "includeAll": true, "allValue": ".+", "multi": true, "current": {"text": "All", "value": "$__all"}},
    {"name": "service", "label": "Service", "type": "query", "datasource": {"uid": "prometheus", "type": "prometheus"}, "query": "label_values(post_call_executions_total{deployment_environment_name=~\"$environment\"}, service_name)", "includeAll": true, "allValue": ".+", "multi": true, "current": {"text": "All", "value": "$__all"}}
  ]},
  "panels": [
    {"id": 1, "type": "stat", "title": "Post-call executions", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(post_call_executions_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__range]))"}], "fieldConfig": {"defaults": {"unit": "short"}}, "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4}},
    {"id": 2, "type": "stat", "title": "Post-call failure rate", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(post_call_failures_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__range])) / sum(increase(post_call_executions_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__range]))"}], "fieldConfig": {"defaults": {"unit": "percentunit"}}, "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4}},
    {"id": 3, "type": "stat", "title": "Post-call duration p95", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(post_call_duration_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))"}], "fieldConfig": {"defaults": {"unit": "s"}}, "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4}},
    {"id": 4, "type": "stat", "title": "Integration executions", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(integration_executions_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__range]))"}], "fieldConfig": {"defaults": {"unit": "short"}}, "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4}},
    {"id": 5, "type": "stat", "title": "Integration failure rate", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(integration_failures_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__range])) / sum(increase(integration_executions_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__range]))"}], "fieldConfig": {"defaults": {"unit": "percentunit"}}, "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4}},
    {"id": 6, "type": "stat", "title": "Integration duration p95", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(integration_duration_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))"}], "fieldConfig": {"defaults": {"unit": "s"}}, "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4}},
    {"id": 7, "type": "timeseries", "title": "Post-call processing duration p50/p95", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le, operation_type) (rate(post_call_duration_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "p50 {{operation_type}}"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le, operation_type) (rate(post_call_duration_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "p95 {{operation_type}}"}], "fieldConfig": {"defaults": {"unit": "s"}}, "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}},
    {"id": 8, "type": "timeseries", "title": "Post-call executions and failures", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (operation_type) (rate(post_call_executions_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "execution {{operation_type}}"}, {"refId": "B", "expr": "sum by (operation_type) (rate(post_call_failures_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "failure {{operation_type}}"}], "fieldConfig": {"defaults": {"unit": "ops"}}, "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}},
    {"id": 9, "type": "timeseries", "title": "Integration execution rate and failures", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (operation_type) (rate(integration_executions_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "execution {{operation_type}}"}, {"refId": "B", "expr": "sum by (operation_type) (rate(integration_failures_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "failure {{operation_type}}"}], "fieldConfig": {"defaults": {"unit": "ops"}}, "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8}},
    {"id": 10, "type": "timeseries", "title": "Integration latency p50/p95", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le, operation_type) (rate(integration_duration_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "p50 {{operation_type}}"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le, operation_type) (rate(integration_duration_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "p95 {{operation_type}}"}], "fieldConfig": {"defaults": {"unit": "s"}}, "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8}}
  ]
}
