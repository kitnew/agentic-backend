{
  "uid": "voice-agent",
  "title": "Voice Agent",
  "tags": ["agentic-backend", "voice"],
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": [
    {"name": "environment", "label": "Environment", "type": "query", "datasource": {"uid": "prometheus", "type": "prometheus"}, "query": "label_values(voice_llm_requests_total, deployment_environment_name)", "includeAll": true, "allValue": ".+", "multi": true, "current": {"text": "All", "value": "$__all"}},
    {"name": "service", "label": "Service", "type": "query", "datasource": {"uid": "prometheus", "type": "prometheus"}, "query": "label_values(voice_llm_requests_total{deployment_environment_name=~\"$environment\"}, service_name)", "includeAll": true, "allValue": ".+", "multi": true, "current": {"text": "All", "value": "$__all"}}
  ]},
  "panels": [
    {"id": 1, "type": "stat", "title": "Turn E2E latency p50", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(voice_turn_e2e_latency_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))"}], "fieldConfig": {"defaults": {"unit": "s"}}, "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}},
    {"id": 2, "type": "stat", "title": "Turn E2E latency p95", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(voice_turn_e2e_latency_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))"}], "fieldConfig": {"defaults": {"unit": "s"}}, "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}},
    {"id": 3, "type": "stat", "title": "LLM TTFT p95", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(voice_turn_llm_ttft_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))"}], "fieldConfig": {"defaults": {"unit": "s"}}, "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4}},
    {"id": 4, "type": "stat", "title": "TTS TTFB p95", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(voice_turn_tts_ttfb_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))"}], "fieldConfig": {"defaults": {"unit": "s"}}, "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4}},
    {"id": 5, "type": "timeseries", "title": "Voice pipeline latency p50", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(voice_turn_transcription_delay_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "STT transcription"}, {"refId": "B", "expr": "histogram_quantile(0.50, sum by (le) (rate(voice_turn_end_of_turn_delay_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "end of turn"}, {"refId": "C", "expr": "histogram_quantile(0.50, sum by (le) (rate(voice_turn_on_user_turn_completed_delay_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "turn completed"}, {"refId": "D", "expr": "histogram_quantile(0.50, sum by (le) (rate(voice_turn_llm_ttft_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "LLM TTFT"}, {"refId": "E", "expr": "histogram_quantile(0.50, sum by (le) (rate(voice_turn_tts_ttfb_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "TTS TTFB"}, {"refId": "F", "expr": "histogram_quantile(0.50, sum by (le) (rate(voice_turn_e2e_latency_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "E2E"}], "fieldConfig": {"defaults": {"unit": "s"}}, "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}},
    {"id": 6, "type": "timeseries", "title": "Voice pipeline latency p95", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(voice_turn_transcription_delay_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "STT transcription"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(voice_turn_end_of_turn_delay_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "end of turn"}, {"refId": "C", "expr": "histogram_quantile(0.95, sum by (le) (rate(voice_turn_on_user_turn_completed_delay_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "turn completed"}, {"refId": "D", "expr": "histogram_quantile(0.95, sum by (le) (rate(voice_turn_llm_ttft_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "LLM TTFT"}, {"refId": "E", "expr": "histogram_quantile(0.95, sum by (le) (rate(voice_turn_tts_ttfb_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "TTS TTFB"}, {"refId": "F", "expr": "histogram_quantile(0.95, sum by (le) (rate(voice_turn_e2e_latency_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "E2E"}], "fieldConfig": {"defaults": {"unit": "s"}}, "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}},
    {"id": 7, "type": "timeseries", "title": "LLM requests and errors", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (voice_provider, voice_model) (rate(voice_llm_requests_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "requests {{voice_provider}}/{{voice_model}}"}, {"refId": "B", "expr": "sum(rate(voice_component_errors_total{voice_component=\"llm\", service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "errors"}], "fieldConfig": {"defaults": {"unit": "ops"}}, "gridPos": {"x": 0, "y": 12, "w": 8, "h": 8}},
    {"id": 8, "type": "timeseries", "title": "LLM token rate and cached-input ratio", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(voice_llm_input_tokens_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "input tokens/s"}, {"refId": "B", "expr": "sum(rate(voice_llm_output_tokens_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "output tokens/s"}, {"refId": "C", "expr": "sum(rate(voice_llm_input_cached_tokens_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])) / clamp_min(sum(rate(voice_llm_input_tokens_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])), 0.000001)", "legendFormat": "cached input ratio"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": [{"matcher": {"id": "byName", "options": "cached input ratio"}, "properties": [{"id": "unit", "value": "percentunit"}]}]}, "gridPos": {"x": 8, "y": 12, "w": 8, "h": 8}},
    {"id": 9, "type": "timeseries", "title": "LLM duration p95", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(voice_llm_duration_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "LLM duration"}], "fieldConfig": {"defaults": {"unit": "s"}}, "gridPos": {"x": 16, "y": 12, "w": 8, "h": 8}},
    {"id": 10, "type": "timeseries", "title": "STT and TTS request health", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(voice_stt_requests_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "STT requests/s"}, {"refId": "B", "expr": "sum(rate(voice_tts_requests_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "TTS requests/s"}, {"refId": "C", "expr": "sum(rate(voice_component_errors_total{voice_component=~\"stt|tts\", service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "STT/TTS errors/s"}], "fieldConfig": {"defaults": {"unit": "ops"}}, "gridPos": {"x": 0, "y": 20, "w": 8, "h": 8}},
    {"id": 11, "type": "timeseries", "title": "STT/TTS workload", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(voice_stt_audio_duration_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "STT audio seconds/s"}, {"refId": "B", "expr": "sum(rate(voice_tts_audio_duration_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "TTS audio seconds/s"}, {"refId": "C", "expr": "sum(rate(voice_tts_characters_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "TTS characters/s"}], "fieldConfig": {"defaults": {"unit": "short"}}, "gridPos": {"x": 8, "y": 20, "w": 8, "h": 8}},
    {"id": 12, "type": "timeseries", "title": "STT and TTS latency p95", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(voice_stt_duration_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "STT duration"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(voice_tts_ttfb_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "TTS TTFB"}, {"refId": "C", "expr": "histogram_quantile(0.95, sum by (le) (rate(voice_tts_duration_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "TTS duration"}], "fieldConfig": {"defaults": {"unit": "s"}}, "gridPos": {"x": 16, "y": 20, "w": 8, "h": 8}},
    {"id": 13, "type": "timeseries", "title": "Voice latency observations in range", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(voice_turn_e2e_latency_seconds_count{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__range]))", "legendFormat": "E2E"}, {"refId": "B", "expr": "sum(increase(voice_turn_llm_ttft_seconds_count{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__range]))", "legendFormat": "LLM TTFT"}, {"refId": "C", "expr": "sum(increase(voice_turn_tts_ttfb_seconds_count{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__range]))", "legendFormat": "TTS TTFB"}, {"refId": "D", "expr": "sum(increase(voice_llm_duration_seconds_count{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__range]))", "legendFormat": "LLM duration"}, {"refId": "E", "expr": "sum(increase(voice_tts_duration_seconds_count{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__range]))", "legendFormat": "TTS duration"}], "fieldConfig": {"defaults": {"unit": "short"}}, "gridPos": {"x": 0, "y": 28, "w": 24, "h": 6}}
  ]
}
