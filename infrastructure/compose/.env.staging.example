# Deployment identity and filesystem paths.
# Copy to .env.staging, chmod 600, and keep it outside Git.
COMPOSE_PROJECT_NAME=agentic-backend-staging
BACKUP_DIR=/var/backups/agentic-backend

# Database, Redis, and service-to-service settings.
POSTGRES_PASSWORD=replace-with-staging-database-password
REDIS_URL=redis://redis:6379/0
ADMIN_API_TOKEN=replace-with-staging-admin-token
AGENTCTL_API_URL=https://replace-with-staging-backend-host
AGENTCTL_TOKEN=replace-with-staging-admin-token
AGENTCTL_STATE_DIR=./definitions
INTERNAL_API_AUDIENCE=backend-core
VOICE_AGENT_SERVICE_SECRET=replace-with-staging-voice-agent-secret
JOB_WORKER_SERVICE_SECRET=replace-with-staging-job-worker-secret

# Generate every random secret with: openssl rand -hex 32
# Generate the Fernet integration key with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Generate a Caddy bcrypt password hash with:
#   docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext 'replace-me'
INTEGRATION_ENCRYPTION_KEY=replace-with-base64-32-byte-integration-encryption-key
CAPABILITY_JOB_STREAM=capability:jobs
CAPABILITY_JOB_CONSUMER_GROUP=capability-workers
CAPABILITY_JOB_DEAD_LETTER_STREAM=capability:jobs:dead-letter
CAPABILITY_JOB_MAX_RETRIES=3
CAPABILITY_JOB_STALE_IDLE_MS=30000
DOMAIN_EVENT_STREAM=domain:events
COMMAND_STREAM=application:commands
COMMAND_CONSUMER_GROUP=job-workers
COMMAND_RESULT_STREAM=application:command-results
COMMAND_DEAD_LETTER_STREAM=application:commands:dead-letter
OUTBOX_DISPATCH_INTERVAL_SECONDS=1
CALL_RUNTIME_RECONCILIATION_ENABLED=true
CALL_RUNTIME_RECONCILIATION_INTERVAL_SECONDS=60
CALL_RUNTIME_RECONCILIATION_GRACE_SECONDS=120
CALL_RUNTIME_RECONCILIATION_BATCH_SIZE=100
CALL_RECORDING_ENABLED=true

# MinIO and recording storage. MINIO_ROOT_* is only for minio-init/admin work.
# Egress gets read/write access; the Worker gets read-only access. Use different
# access keys and secrets for each role, and keep them stable after first start.
# Example access-key names: agentic-egress and agentic-worker.
# Generate each secret with: openssl rand -hex 32
LIVEKIT_EGRESS_REDIS_ADDRESS=redis:6379
LIVEKIT_EGRESS_HEALTH_PORT=8080
MINIO_ROOT_USER=replace-with-staging-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-staging-minio-root-password
MINIO_EGRESS_ACCESS_KEY=agentic-egress
MINIO_EGRESS_SECRET_KEY=replace-with-staging-egress-secret-key
MINIO_WORKER_ACCESS_KEY=agentic-worker
MINIO_WORKER_SECRET_KEY=replace-with-staging-worker-secret-key
MINIO_BUCKET=call-recordings
MINIO_REGION=eu-central-1
MINIO_ENDPOINT_INTERNAL=http://minio:9000
MINIO_WORKER_ENDPOINT=minio:9000
MINIO_SECURE=false
CAPABILITY_INVOCATION_PII_RETENTION_SECONDS=2592000
CAPABILITY_OUTBOX_RETENTION_SECONDS=604800
CAPABILITY_STREAM_MAXLEN=10000
CAPABILITY_RETENTION_MAINTENANCE_INTERVAL_SECONDS=3600
ALLOW_INSECURE_MANAGED_WEBHOOKS=false

# LiveKit and SIP. LIVEKIT_NODE_IP is the server's public IP.
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=wss://replace-with-staging-livekit-host
LIVEKIT_NODE_IP=replace-with-staging-livekit-node-ip
LIVEKIT_UDP_PORT=7882
LIVEKIT_TCP_PORT=7881
LIVEKIT_API_KEY=replace-with-staging-livekit-api-key
LIVEKIT_API_SECRET=replace-with-staging-livekit-api-secret
LIVEKIT_AGENT_NAME=hospitality-voice-agent
LIVEKIT_PARTICIPANT_TOKEN_TTL_SECONDS=600
LIVEKIT_SIP_REDIS_ADDRESS=redis:6379
LIVEKIT_SIP_PORT=5060
LIVEKIT_SIP_RTP_PORT=10000-20000
LIVEKIT_SIP_HEALTH_PORT=8080
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=ST_replace_me

# Provider API credentials and runtime URLs. Use the exact Azure deployment name.
BACKEND_CORE_URL=http://backend:8000
BACKEND_HTTP_TIMEOUT_SECONDS=10
ELEVENLABS_API_KEY=replace-with-staging-elevenlabs-api-key
AZURE_OPENAI_API_KEY=replace-with-staging-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://replace-me.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=replace-with-staging-azure-openai-deployment
AZURE_OPENAI_API_VERSION=2025-01-01-preview
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_RETRY_LIMIT=3
PARTICIPANT_WAIT_TIMEOUT_SECONDS=300
CAPABILITY_POLL_TIMEOUT_SECONDS=15
CAPABILITY_POLL_INTERVAL_SECONDS=0.15

# Observability. Grafana, Prometheus, Tempo, and the Collector run in staging.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=backend-core
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=staging
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
PROMETHEUS_RETENTION_TIME=15d
TEMPO_RETENTION=168h

# Public DNS/TLS. Use staging-only names; do not point these at production.
CADDY_EMAIL=ops@example.invalid
API_DOMAIN=api.staging.example.invalid
ADMIN_WEB_DOMAIN=admin.staging.example.invalid
ADMIN_WEB_GRAFANA_URL=https://grafana.staging.example.invalid
LIVEKIT_DOMAIN=livekit.staging.example.invalid
GRAFANA_DOMAIN=grafana.staging.example.invalid

# Admin Web Basic Auth and Grafana login.
ADMIN_WEB_BASIC_AUTH_USER=replace-with-staging-admin-user
ADMIN_WEB_BASIC_AUTH_HASH='$2a$14$replace-with-staging-bcrypt-hash'
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-staging-grafana-admin-password

# Docker log rotation.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5
