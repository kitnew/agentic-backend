COMPOSE_PROJECT_NAME=agentic-backend-production
BACKUP_DIR=/var/backups/agentic-backend
POSTGRES_PASSWORD=replace-with-production-database-password
REDIS_URL=redis://redis:6379/0
ADMIN_API_TOKEN=replace-with-production-admin-token
AGENTCTL_API_URL=https://replace-with-production-backend-host
AGENTCTL_TOKEN=replace-with-production-admin-token
AGENTCTL_STATE_DIR=./definitions
INTERNAL_API_AUDIENCE=backend-core
VOICE_AGENT_SERVICE_SECRET=replace-with-production-voice-agent-secret
JOB_WORKER_SERVICE_SECRET=replace-with-production-job-worker-secret
INTEGRATION_ENCRYPTION_KEY=replace-with-base64-32-byte-integration-encryption-key
CAPABILITY_JOB_STREAM=capability:jobs
CAPABILITY_JOB_CONSUMER_GROUP=capability-workers
CAPABILITY_JOB_DEAD_LETTER_STREAM=capability:jobs:dead-letter
CAPABILITY_JOB_MAX_RETRIES=3
CAPABILITY_JOB_STALE_IDLE_MS=30000
DOMAIN_EVENT_STREAM=domain:events
COMMAND_STREAM=application:commands
COMMAND_CONSUMER_GROUP=job-workers
COMMAND_RESULT_STREAM=application:command-results
COMMAND_DEAD_LETTER_STREAM=application:commands:dead-letter
OUTBOX_DISPATCH_INTERVAL_SECONDS=1
CALL_RUNTIME_RECONCILIATION_ENABLED=true
CALL_RUNTIME_RECONCILIATION_INTERVAL_SECONDS=60
CALL_RUNTIME_RECONCILIATION_GRACE_SECONDS=120
CALL_RUNTIME_RECONCILIATION_BATCH_SIZE=100
CALL_RECORDING_ENABLED=true
LIVEKIT_EGRESS_REDIS_ADDRESS=redis:6379
LIVEKIT_EGRESS_HEALTH_PORT=8080
MINIO_ROOT_USER=replace-with-production-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-production-minio-root-password
MINIO_EGRESS_ACCESS_KEY=replace-with-production-egress-access-key
MINIO_EGRESS_SECRET_KEY=replace-with-production-egress-secret-key
MINIO_WORKER_ACCESS_KEY=replace-with-production-worker-access-key
MINIO_WORKER_SECRET_KEY=replace-with-production-worker-secret-key
MINIO_BUCKET=call-recordings
MINIO_REGION=us-east-1
MINIO_ENDPOINT_INTERNAL=http://minio:9000
MINIO_WORKER_ENDPOINT=minio:9000
MINIO_SECURE=false
CAPABILITY_INVOCATION_PII_RETENTION_SECONDS=2592000
CAPABILITY_OUTBOX_RETENTION_SECONDS=604800
CAPABILITY_STREAM_MAXLEN=10000
CAPABILITY_RETENTION_MAINTENANCE_INTERVAL_SECONDS=3600
ALLOW_INSECURE_MANAGED_WEBHOOKS=false
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=wss://replace-with-production-livekit-host
LIVEKIT_NODE_IP=replace-with-production-livekit-node-ip
LIVEKIT_UDP_PORT=7882
LIVEKIT_TCP_PORT=7881
LIVEKIT_API_KEY=replace-with-production-livekit-api-key
LIVEKIT_API_SECRET=replace-with-production-livekit-api-secret
LIVEKIT_AGENT_NAME=hospitality-voice-agent
LIVEKIT_PARTICIPANT_TOKEN_TTL_SECONDS=600
LIVEKIT_SIP_REDIS_ADDRESS=redis:6379
LIVEKIT_SIP_PORT=5060
LIVEKIT_SIP_RTP_PORT=10000-20000
LIVEKIT_SIP_HEALTH_PORT=8080
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=ST_replace_me
BACKEND_CORE_URL=http://backend:8000
BACKEND_HTTP_TIMEOUT_SECONDS=10
ELEVENLABS_API_KEY=replace-with-production-elevenlabs-api-key
AZURE_OPENAI_API_KEY=replace-with-production-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://replace-me.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=replace-with-production-azure-openai-deployment
AZURE_OPENAI_API_VERSION=2025-01-01-preview
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_RETRY_LIMIT=3
PARTICIPANT_WAIT_TIMEOUT_SECONDS=300
CAPABILITY_POLL_TIMEOUT_SECONDS=15
CAPABILITY_POLL_INTERVAL_SECONDS=0.15
CADDY_EMAIL=ops@example.invalid
API_DOMAIN=api.example.invalid
DEBUG_CHAT_DOMAIN=debug.example.invalid
ADMIN_WEB_DOMAIN=admin.example.invalid
LIVEKIT_DOMAIN=livekit.example.invalid
DEBUG_CHAT_BASIC_AUTH_USER=replace-with-production-debug-user
DEBUG_CHAT_BASIC_AUTH_HASH='$2a$14$replace-with-production-bcrypt-hash'
ADMIN_WEB_BASIC_AUTH_USER=replace-with-production-admin-user
ADMIN_WEB_BASIC_AUTH_HASH='$2a$14$replace-with-production-bcrypt-hash'
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5
