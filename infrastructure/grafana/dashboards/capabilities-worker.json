{
  "uid": "capabilities-worker",
  "title": "Capabilities & Worker",
  "tags": ["agentic-backend", "capabilities", "worker"],
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": [
    {"name": "environment", "label": "Environment", "type": "query", "datasource": {"uid": "prometheus", "type": "prometheus"}, "query": "label_values(capability_executions_total, deployment_environment_name)", "includeAll": true, "allValue": ".+", "multi": true, "current": {"text": "All", "value": "$__all"}},
    {"name": "service", "label": "Service", "type": "query", "datasource": {"uid": "prometheus", "type": "prometheus"}, "query": "label_values(capability_executions_total{deployment_environment_name=~\"$environment\"}, service_name)", "includeAll": true, "allValue": ".+", "multi": true, "current": {"text": "All", "value": "$__all"}},
    {"name": "capability", "label": "Capability", "type": "query", "datasource": {"uid": "prometheus", "type": "prometheus"}, "query": "label_values(capability_executions_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}, capability_name)", "includeAll": true, "allValue": ".+", "multi": true, "current": {"text": "All", "value": "$__all"}}
  ]},
  "panels": [
    {"id": 1, "type": "row", "title": "Logical capability outcome", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}},
    {"id": 2, "type": "stat", "title": "Logical capability executions", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "round(sum(increase(capability_executions_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\", capability_name=~\"$capability\"}[$__range])))"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}}, "gridPos": {"x": 0, "y": 1, "w": 6, "h": 4}},
    {"id": 3, "type": "stat", "title": "Capability success rate", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "(sum(increase(capability_executions_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\", capability_name=~\"$capability\"}[$__range])) - sum(increase(capability_failures_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\", capability_name=~\"$capability\"}[$__range]))) / sum(increase(capability_executions_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\", capability_name=~\"$capability\"}[$__range]))"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}, "gridPos": {"x": 6, "y": 1, "w": 6, "h": 4}},
    {"id": 4, "type": "stat", "title": "Logical capability failures", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "round(sum(increase(capability_failures_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\", capability_name=~\"$capability\"}[$__range])))"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}}, "gridPos": {"x": 12, "y": 1, "w": 6, "h": 4}},
    {"id": 5, "type": "stat", "title": "Capability execution p95", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(capability_execution_duration_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\", capability_name=~\"$capability\"}[$__rate_interval])))"}], "fieldConfig": {"defaults": {"unit": "s"}}, "gridPos": {"x": 18, "y": 1, "w": 6, "h": 4}},
    {"id": 6, "type": "table", "title": "Capabilities ranked by logical failure rate", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sort_desc(sum by (capability_name) (increase(capability_failures_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\", capability_name=~\"$capability\"}[$__range])) / sum by (capability_name) (increase(capability_executions_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\", capability_name=~\"$capability\"}[$__range])))", "instant": true, "format": "table"}], "fieldConfig": {"defaults": {"unit": "percentunit"}}, "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8}},
    {"id": 7, "type": "timeseries", "title": "Logical capability execution p95 by capability", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, capability_name) (rate(capability_execution_duration_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\", capability_name=~\"$capability\"}[$__rate_interval])))", "legendFormat": "{{capability_name}}"}], "fieldConfig": {"defaults": {"unit": "s"}}, "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8}},
    {"id": 8, "type": "timeseries", "title": "Logical capability executions and failures by capability", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (capability_name) (rate(capability_executions_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\", capability_name=~\"$capability\"}[$__rate_interval]))", "legendFormat": "execution {{capability_name}}"}, {"refId": "B", "expr": "sum by (capability_name) (rate(capability_failures_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\", capability_name=~\"$capability\"}[$__rate_interval]))", "legendFormat": "failure {{capability_name}}"}], "fieldConfig": {"defaults": {"unit": "ops"}}, "gridPos": {"x": 0, "y": 13, "w": 12, "h": 8}},
    {"id": 9, "type": "timeseries", "title": "Logical capability execution p50 by capability", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le, capability_name) (rate(capability_execution_duration_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\", capability_name=~\"$capability\"}[$__rate_interval])))", "legendFormat": "{{capability_name}}"}], "fieldConfig": {"defaults": {"unit": "s"}}, "gridPos": {"x": 12, "y": 13, "w": 12, "h": 8}},
    {"id": 10, "type": "row", "title": "Physical Worker attempts", "gridPos": {"x": 0, "y": 21, "w": 24, "h": 1}},
    {"id": 11, "type": "timeseries", "title": "Worker command attempts and failures", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (operation_type) (rate(worker_command_attempts_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "attempt {{operation_type}}"}, {"refId": "B", "expr": "sum by (operation_type) (rate(worker_command_failures_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "failure {{operation_type}}"}], "fieldConfig": {"defaults": {"unit": "ops"}}, "gridPos": {"x": 0, "y": 22, "w": 12, "h": 8}},
    {"id": 12, "type": "timeseries", "title": "Worker attempt duration p50/p95", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(worker_command_duration_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "p50"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(worker_command_duration_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "p95"}], "fieldConfig": {"defaults": {"unit": "s"}}, "gridPos": {"x": 12, "y": 22, "w": 12, "h": 8}},
    {"id": 13, "type": "timeseries", "title": "Worker retries and DLQ transitions", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (operation_type) (rate(worker_command_retries_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "retry {{operation_type}}"}, {"refId": "B", "expr": "sum by (operation_type) (rate(worker_command_dlq_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "DLQ {{operation_type}}"}], "fieldConfig": {"defaults": {"unit": "ops"}}, "gridPos": {"x": 0, "y": 30, "w": 12, "h": 8}},
    {"id": 14, "type": "timeseries", "title": "Physical capability execution attempts", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (capability_name) (rate(worker_capability_execution_attempts_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\", capability_name=~\"$capability\"}[$__rate_interval]))", "legendFormat": "{{capability_name}}"}], "fieldConfig": {"defaults": {"unit": "ops"}}, "gridPos": {"x": 12, "y": 30, "w": 12, "h": 8}}
  ]
}
