{
  "uid": "agentic-backend-overview",
  "title": "Agentic Backend — Overview",
  "tags": ["agentic-backend", "overview"],
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "links": [
    {"title": "Voice Agent", "type": "link", "url": "/d/voice-agent", "includeTimeRange": true, "includeVars": true},
    {"title": "Capabilities & Worker", "type": "link", "url": "/d/capabilities-worker", "includeTimeRange": true, "includeVars": true},
    {"title": "Post-call & Integrations", "type": "link", "url": "/d/post-call-integrations", "includeTimeRange": true, "includeVars": true},
    {"title": "Explore traces", "type": "link", "url": "/explore", "includeTimeRange": true}
  ],
  "templating": {"list": [
    {"name": "environment", "label": "Environment", "type": "query", "datasource": {"uid": "prometheus", "type": "prometheus"}, "query": "label_values(call_started_total, deployment_environment_name)", "includeAll": true, "allValue": ".+", "multi": true, "current": {"text": "All", "value": "$__all"}},
    {"name": "service", "label": "Service", "type": "query", "datasource": {"uid": "prometheus", "type": "prometheus"}, "query": "label_values(call_started_total{deployment_environment_name=~\"$environment\"}, service_name)", "includeAll": true, "allValue": ".+", "multi": true, "current": {"text": "All", "value": "$__all"}}
  ]},
  "panels": [
    {"id": 1, "type": "stat", "title": "Active calls", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(call_active{service_name=~\"$service\", deployment_environment_name=~\"$environment\"})"}], "fieldConfig": {"defaults": {"unit": "short"}}, "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4}},
    {"id": 2, "type": "stat", "title": "Calls started", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(call_started_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__range]))"}], "fieldConfig": {"defaults": {"unit": "short"}}, "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4}},
    {"id": 3, "type": "stat", "title": "Call success rate", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(call_completed_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__range])) / (sum(increase(call_completed_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__range])) + sum(increase(call_failed_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__range])))"}], "fieldConfig": {"defaults": {"unit": "percentunit"}}, "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4}},
    {"id": 4, "type": "stat", "title": "Failed calls", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(call_failed_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__range]))"}], "fieldConfig": {"defaults": {"unit": "short"}}, "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4}},
    {"id": 5, "type": "stat", "title": "Call duration p50", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(call_duration_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))"}], "fieldConfig": {"defaults": {"unit": "s"}}, "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4}},
    {"id": 6, "type": "stat", "title": "Call duration p95", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(call_duration_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))"}], "fieldConfig": {"defaults": {"unit": "s"}}, "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4}},
    {"id": 7, "type": "timeseries", "title": "Call throughput", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(call_started_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "started/s"}], "fieldConfig": {"defaults": {"unit": "ops"}}, "gridPos": {"x": 0, "y": 4, "w": 8, "h": 8}},
    {"id": 8, "type": "timeseries", "title": "Completed and failed calls", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(call_completed_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "completed/s"}, {"refId": "B", "expr": "sum(rate(call_failed_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "failed/s"}], "fieldConfig": {"defaults": {"unit": "ops"}}, "gridPos": {"x": 8, "y": 4, "w": 8, "h": 8}},
    {"id": 9, "type": "timeseries", "title": "Call success rate", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(call_completed_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])) / (sum(rate(call_completed_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])) + sum(rate(call_failed_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "success"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}, "gridPos": {"x": 16, "y": 4, "w": 8, "h": 8}},
    {"id": 10, "type": "timeseries", "title": "Call duration quantiles", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(call_duration_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "p50"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(call_duration_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "p95"}, {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(call_duration_seconds_bucket{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])))", "legendFormat": "p99"}], "fieldConfig": {"defaults": {"unit": "s"}}, "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8}},
    {"id": 11, "type": "timeseries", "title": "Subsystem failures", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(capability_failures_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "capabilities/s"}, {"refId": "B", "expr": "sum(rate(worker_command_failures_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "worker/s"}, {"refId": "C", "expr": "sum(rate(post_call_failures_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "post-call/s"}, {"refId": "D", "expr": "sum(rate(integration_failures_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "integrations/s"}], "fieldConfig": {"defaults": {"unit": "ops"}}, "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8}},
    {"id": 12, "type": "timeseries", "title": "Capability failure rate", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(capability_failures_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])) / sum(rate(capability_executions_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "failure rate"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}, "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8}},
    {"id": 13, "type": "timeseries", "title": "Worker retries and DLQ transitions", "datasource": {"uid": "prometheus", "type": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(worker_command_retries_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "retries/s"}, {"refId": "B", "expr": "sum(rate(worker_command_dlq_total{service_name=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))", "legendFormat": "DLQ/s"}], "fieldConfig": {"defaults": {"unit": "ops"}}, "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8}}
  ]
}
