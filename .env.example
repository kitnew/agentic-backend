# Local Docker Compose development only.
APP_ENV=development
LIVEKIT_DEBUG_AUTH_ENABLED=true
LIVEKIT_DEBUG_ALLOWED_TENANTS=demo_restaurant,penzion_grand
VOICE_TURN_DEBUG_OVERRIDES_ENABLED=true
INBOUND_SIP_ENABLED=false

# Generate three independent values with `openssl rand -hex 32`.
POSTGRES_PASSWORD=
VOICE_SESSION_TOKEN_SECRET=
LIVEKIT_SESSION_AUTH_SECRET=
LIVEKIT_BACKEND_TOKEN_TTL_SECONDS=7200

# Existing external LiveKit deployment.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_INTERNAL_URL=
LIVEKIT_PUBLIC_URL=

# Optional expected identifiers for production/staging inbound SIP only.
LIVEKIT_SIP_INTERNAL_URL=ws://127.0.0.1:7880
LIVEKIT_SIP_REDIS_ADDRESS=127.0.0.1:6379
LIVEKIT_SIP_HEALTH_PORT=8082
LIVEKIT_SIP_EXPECTED_TRUNK_ID=
LIVEKIT_SIP_EXPECTED_RULE_ID=

# Development-scoped provider credentials.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
ELEVENLABS_API_KEY=
