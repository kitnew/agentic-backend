# Local Docker Compose development only.
APP_ENV=development
LIVEKIT_DEBUG_AUTH_ENABLED=true
LIVEKIT_DEBUG_ALLOWED_TENANTS=demo_restaurant,penzion_grand
VOICE_TURN_DEBUG_OVERRIDES_ENABLED=true

# Generate three independent values with `openssl rand -hex 32`.
POSTGRES_PASSWORD=
VOICE_SESSION_TOKEN_SECRET=
LIVEKIT_SESSION_AUTH_SECRET=

# Existing external LiveKit deployment.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_INTERNAL_URL=
LIVEKIT_PUBLIC_URL=

# Development-scoped provider credentials.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
ELEVENLABS_API_KEY=
